# .env.example -- copy to .env and fill in real values. .env is gitignored;
# never commit real keys. app.py, eval_harness.py, agent_graph.py, and
# nl_to_sql_planner.py all load .env at startup via python-dotenv.

# ---- Data-endpoint auth (app.py) -------------------------------------------
# Require a key on the data endpoints. If API_KEY is unset the service REFUSES
# to start unless ALLOW_OPEN_ACCESS is set. Never deploy publicly without this.
API_KEY=change-me
# ALLOW_OPEN_ACCESS=false          # set true only to run OPEN in local dev

# ---- Rate limiting (slowapi, keyed per API key) ----------------------------
RATE_LIMIT_QUERY=20/minute         # LLM-backed endpoints
RATE_LIMIT_READ=60/minute          # cheap reads
RATE_LIMIT_STORAGE=memory://       # e.g. redis://... for multi-instance

# ---- Planner / LLM provider ------------------------------------------------
# gemini | groq | cerebras | xai | anthropic. Set the key matching your choice.
# NOTE: if PLANNER_PROVIDER is unset, nl_to_sql_planner.py falls back to
# 'cerebras'. Set it explicitly so the provider is never a surprise.
#
# Gemini is what CI and both eval suites run on (verified 63/63 cases at 100%)
# and its free tier has the headroom for a full sweep, so it is the default here.
PLANNER_PROVIDER=gemini
PLANNER_MIN_INTERVAL_SEC=5         # pace calls for free/low-tier rate limits

GEMINI_API_KEY=                    # free key at aistudio.google.com
# GEMINI_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=gsk_...               # Groq (api.groq.com); serves openai/gpt-oss-120b
                                   # free tier ~30 RPM / 8K TPM -> use MIN_INTERVAL 12
CEREBRAS_API_KEY=
XAI_API_KEY=xai-...                # xAI/Grok (api.x.ai) -- DIFFERENT vendor from Groq
# XAI_MODEL=grok-3
ANTHROPIC_API_KEY=                 # native Anthropic SDK (not the OpenAI-compat endpoint)
# ANTHROPIC_MODEL=claude-haiku-5-5   # default; claude-sonnet-4-5 retires 2026-11-30

# ---- Data / schema ---------------------------------------------------------
# PLANNER_SCHEMA must match the database you connect to, or schema_check.py
# fails the graph at startup (that is the point -- see schema_check.py).
PLANNER_SCHEMA=hospital            # hospital | fhir
# HOSPITAL_GOLD_DB=medallion/hospital_gold.duckdb
# FHIR_GOLD_DB=medallion/fhir_gold.duckdb   # derived artifact, gitignored; build it first
# EVAL_DATASET=hospital            # hospital | fhir
# EVAL_RUNS=3                      # runs per eval case
# EVAL_SUBSET=1                    # quick tagged subset only
# APPROVALS_DB=logs/approvals.sqlite
# CHECKPOINT_DB=logs/checkpoints.sqlite   # LangGraph checkpoints (planner + approval graphs)
# TRACE_DB=logs/traces.sqlite             # run traces (tracing.py); GET /traces
# TRACE_MAX_RUNS=2000                     # newest runs kept; older ones pruned
# AUDIT_LOG_DIR=logs                      # runtime audit log; empty string disables

# ---- Data backend ----------------------------------------------------------
# local (DuckDB, the default) | databricks (Delta). The guard runs FIRST on both
# paths, so governance is identical either way. The UI can also pick per query.
# The Databricks path is VERIFIED against a real workspace and needs:
#     pip install databricks-sql-connector==4.4.0
# DATA_BACKEND=local
# DATABRICKS_SERVER_HOSTNAME=
# DATABRICKS_HTTP_PATH=
# DATABRICKS_TOKEN=
# DATABRICKS_CATALOG=workspace     # defaults to 'main' if unset
# DATABRICKS_SCHEMA=gold
